<UserControl
    x:Class="Jellyfin.Controls.LazyLoadedImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jellyfin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:Microsoft.Toolkit.Uwp.UI.Controls"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <tk:ImageEx
        Width="{x:Bind ViewModel.Width, Mode=OneWay}"
        Height="{x:Bind ViewModel.Height, Mode=OneWay}"
        Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
        PlaceholderSource="{x:Bind ViewModel.PlaceholderSource, Mode=OneWay}"
        PlaceholderStretch="UniformToFill"
        EnableLazyLoading="{x:Bind ViewModel.EnableBlurHash, Mode=OneWay}" />
</UserControl>
